<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Get-Lost" Width="1100" Height="720" WindowStartupLocation="CenterScreen"
        Background="#09080e">
    <Window.Resources>
        <LinearGradientBrush x:Key="StoneBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#93795a" Offset="0"/>
            <GradientStop Color="#6b5a45" Offset="0.55"/>
            <GradientStop Color="#362a1c" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="StoneButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource StoneBrush}"/>
            <Setter Property="Foreground" Value="#ece0c8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="BorderBrush" Value="#362a1c"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#d98a3d"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LanResultButton" TargetType="Button" BasedOn="{StaticResource StoneButton}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Hintergrund: unscharfes Vorschaubild, wie menu.css es im Browser macht -->
        <Image x:Name="BackgroundImage" Stretch="UniformToFill">
            <Image.Effect>
                <BlurEffect Radius="14"/>
            </Image.Effect>
        </Image>
        <Border Background="#B0000000"/>

        <!-- Hauptmenue -->
        <Grid x:Name="MenuPanel">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="MenuPanelTransform" X="0"/>
            </Grid.RenderTransform>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="480">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                    <TextBlock Text="Get" FontSize="56" FontWeight="Bold" Foreground="#ece0c8"/>
                    <TextBlock Text="Lost" FontSize="56" FontWeight="Bold" Foreground="#ffb15c"/>
                </StackPanel>
                <Button x:Name="NicknameChangeButton" Style="{StaticResource LanResultButton}"
                        HorizontalAlignment="Center" Margin="0,0,0,20" FontSize="12" Padding="8,4"/>
                <Button x:Name="StartGameButton" Content="START GAME" Style="{StaticResource StoneButton}"
                        Margin="0,0,0,14" FontSize="20" Padding="18,22"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="LanHostButton" Grid.Column="0" Content="OPEN TO LAN" Style="{StaticResource StoneButton}"/>
                    <Button x:Name="LanFindButton" Grid.Column="2" Content="FINDING LOCAL GAMES" Style="{StaticResource StoneButton}"/>
                </Grid>
                <TextBlock x:Name="LanStatusText" Margin="0,10,0,0" FontSize="12" Foreground="#c9bfa8"
                           HorizontalAlignment="Center" TextWrapping="Wrap"/>
                <StackPanel x:Name="LanResultsPanel" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Lobby: erscheint nach "Open to LAN" (als Host) oder nach dem
             Klick auf ein gefundenes Spiel (als Gast). Host sieht die
             Spielerliste + einen Start-Button; Gast sieht dieselbe Liste
             und wartet, bis der Host startet. -->
        <Grid x:Name="LobbyPanel" Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="LobbyPanelTransform" X="0"/>
            </Grid.RenderTransform>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                <TextBlock Text="LOBBY" FontSize="40" FontWeight="Bold" Foreground="#ffb15c"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock x:Name="LobbyHostNameText" FontSize="13" Foreground="#c9bfa8"
                           HorizontalAlignment="Center" Margin="0,0,0,20" TextWrapping="Wrap"/>
                <Border Background="#40000000" BorderBrush="#362a1c" BorderThickness="2" CornerRadius="4"
                        Padding="14,10" Margin="0,0,0,20">
                    <StackPanel x:Name="LobbyPlayersPanel" MinHeight="30"/>
                </Border>
                <TextBlock x:Name="LobbyWaitingText" Text="Warte auf den Host..." FontSize="14" Foreground="#c9bfa8"
                           HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,14"/>
                <Button x:Name="LobbyStartButton" Content="SPIEL STARTEN" Style="{StaticResource StoneButton}"
                        FontSize="18" Padding="18,20" Margin="0,0,0,10" Visibility="Collapsed"/>
                <Button x:Name="LobbyLeaveButton" Content="Lobby verlassen" Style="{StaticResource StoneButton}"
                        FontSize="13" Padding="10,8"/>
            </StackPanel>
        </Grid>

        <!-- Maze-Ansicht (Phase 3b: echtes Tile-/Wand-/Muenzen-Rendering,
             siehe MapRenderer.ps1). MazeImage traegt das gebackene
             PixelCanvas als WriteableBitmap; CoinLayer legt einzelne,
             per DispatcherTimer animierte Muenzen-Images darueber. -->
        <Grid x:Name="MazePanel" Visibility="Collapsed" Background="#09080e">
            <DockPanel Margin="12">
                <Button x:Name="LeaveGameButton" Content="SPIEL VERLASSEN" DockPanel.Dock="Top" HorizontalAlignment="Left"
                        Style="{StaticResource StoneButton}" Padding="10,6" FontSize="13" Margin="0,0,0,12"/>
                <ScrollViewer x:Name="MazeScrollViewer"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              Focusable="False">
                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Image x:Name="MazeImage" Stretch="None" SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <Canvas x:Name="TorchLayer" IsHitTestVisible="False"/>
                        <Canvas x:Name="CoinLayer" IsHitTestVisible="False"/>
                        <!-- Eigener Actor-Layer: Der Spieler kann sich bewegen,
                             ohne dass die gebackene Karte bei jedem Frame neu
                             gerendert werden muss. -->
                        <Canvas x:Name="PlayerLayer" IsHitTestVisible="False"/>
                        <!-- Andere Spieler (Host/Gaeste) waehrend einer
                             laufenden LAN-Runde - siehe Start-RemotePlayerSync
                             in Start-GetLost.ps1. Jeder Eintrag ist ein
                             Sprite + ein Namens-Label darueber. -->
                        <Canvas x:Name="RemotePlayersLayer" IsHitTestVisible="False"/>
                    </Grid>
                </ScrollViewer>
            </DockPanel>

            <!-- Muenzzaehler-HUD: bewusst AUSSERHALB des ScrollViewers, also
                 fest an der Fensterecke statt mit der Karte mitzuscrollen.
                 Zaehlt global (alle Spieler zusammen), siehe
                 Update-CoinCounterDisplay in Start-GetLost.ps1. -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18"
                    Background="#CC1c1712" BorderBrush="#544027" BorderThickness="2" CornerRadius="6"
                    Padding="10,6">
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="CoinCounterIcon" Width="24" Height="24" Margin="0,0,8,0"
                           SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <TextBlock x:Name="CoinCounterText" Text="0" FontSize="18" FontWeight="Bold"
                               Foreground="#ffb15c" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bleibt nach dem Verlassen einer laufenden Gast-Runde sichtbar.
             Der Status wird read-only beim Host geprueft; erst der Button
             "Wieder beitreten" meldet den Spieler erneut an. -->
        <Border x:Name="GameToast" Visibility="Collapsed" Panel.ZIndex="20"
                HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="920"
                Margin="18" Padding="14,10" CornerRadius="5"
                Background="#F2211812" BorderBrush="#d98a3d" BorderThickness="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="GameToastText" Grid.Column="0" VerticalAlignment="Center"
                           Foreground="#ece0c8" FontSize="14" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,0,16,0"/>
                <Button x:Name="GameToastRejoinButton" Grid.Column="1" Content="WIEDER BEITRETEN"
                        Style="{StaticResource StoneButton}" Padding="10,6" FontSize="12" Margin="0,0,8,0"/>
                <Button x:Name="GameToastDismissButton" Grid.Column="2" Content="SCHLIESSEN"
                        Style="{StaticResource StoneButton}" Padding="10,6" FontSize="12"/>
            </Grid>
        </Border>

        <!-- Ladeanzeige waehrend die Karte (auf einem Hintergrund-Runspace,
             siehe Start-MapRenderAsync in Start-GetLost.ps1) generiert wird.
             Erscheint an derselben Stelle, von der das Menue wegschiebt -
             kein eigener dunkler Hintergrund noetig, der unscharfe
             Menue-Hintergrund bleibt einfach sichtbar. Liegt ueber allem
             anderen, deshalb ganz am Ende des Grids. -->
        <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Background="Transparent" Panel.ZIndex="30">
            <Ellipse x:Name="LoadingSpinner" Width="64" Height="64" StrokeThickness="6"
                     Stroke="#d98a3d" StrokeDashArray="3 2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <RotateTransform x:Name="LoadingSpinnerRotate" Angle="0"/>
                        <ScaleTransform x:Name="LoadingSpinnerScale" ScaleX="1" ScaleY="1"/>
                    </TransformGroup>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Grid>

        <!-- Namens-Dialog: liegt ueber dem (weiterhin sichtbaren, nur
             abgedunkelten) Menue - siehe Show-NicknameDialog in
             Start-GetLost.ps1. Erscheint beim ersten Start (kein
             gespeicherter Name) und wenn man in der Kopfzeile auf den
             eigenen Namen klickt. -->
        <Grid x:Name="NicknamePanel" Visibility="Collapsed" Background="#B0000000" Panel.ZIndex="40">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="380"
                    Background="#1c1712" BorderBrush="#362a1c" BorderThickness="2" CornerRadius="6"
                    Padding="24">
                <StackPanel>
                    <TextBlock Text="Wie heisst du?" FontSize="22" FontWeight="Bold" Foreground="#ffb15c"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Dieser Name wird anderen Spielern im LAN angezeigt." FontSize="12"
                               Foreground="#c9bfa8" TextWrapping="Wrap" HorizontalAlignment="Center"
                               TextAlignment="Center" Margin="0,0,0,16"/>
                    <TextBox x:Name="NicknameInput" FontSize="16" Padding="8,6" MaxLength="20"
                             Background="#0f0c09" Foreground="#ece0c8" BorderBrush="#544027" BorderThickness="2"
                             CaretBrush="#ece0c8" Margin="0,0,0,16"/>
                    <Button x:Name="NicknameConfirmButton" Content="LOS GEHT'S" Style="{StaticResource StoneButton}"
                            FontSize="15" Padding="12,12"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
