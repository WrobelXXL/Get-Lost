<!--
    MainWindow.xaml - Fenster von Get-Lost (Port von index.php + style.css)

    Drei Ebenen uebereinander (wie die z-index-Ebenen im Browser):
      Particles     - schwebende Funken im Hintergrund (nur Startbildschirm)
      StartScreen   - Titel + Menue
      GameView      - die Karte (ScrollViewer) + HUD oben links
      LoadingScreen - Spinner + Lade-Texte
    Die Farben/Groessen sind 1:1 aus dem CSS uebernommen.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Get-Lost" Width="1280" Height="860" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="#0a0a0f"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI" Foreground="#e8dcc0">
    <Window.Resources>
        <!-- .menu-btn -->
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Foreground" Value="#e8dcc0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Glow" Background="#0a0a0f" BorderThickness="0" Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#c9843a" BlurRadius="30" ShadowDepth="0" Opacity="0.15" />
                                </Border.Effect>
                            </Border>
                            <Border x:Name="Frame" BorderThickness="2">
                                <Border.BorderBrush>
                                    <SolidColorBrush x:Name="FrameBrush" Color="#3c2a1c" />
                                </Border.BorderBrush>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#1a1510" Offset="0" />
                                        <GradientStop Color="#12100d" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <!-- .menu-btn::before -->
                                    <Border x:Name="Shine" Opacity="0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#1Ac9843a" Offset="0" />
                                                <GradientStop Color="#00c9843a" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <ContentPresenter Margin="32,18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsEnabled" Value="True" />
                                </MultiTrigger.Conditions>
                                <MultiTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="FrameBrush" Storyboard.TargetProperty="Color" To="#c9843a" Duration="0:0:0.3" />
                                            <DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3" />
                                            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.02" Duration="0:0:0.3" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.02" Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="FrameBrush" Storyboard.TargetProperty="Color" To="#3c2a1c" Duration="0:0:0.3" />
                                            <DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                                            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.3" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.ExitActions>
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#2a2a2a" />
                                <Setter Property="Cursor" Value="No" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Spinner-Ring: Bogen eines Kreises (CSS border-top/-right usw.) -->
        <Style x:Key="Ring" TargetType="Path">
            <Setter Property="StrokeThickness" Value="3" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stretch" Value="None" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" ClipToBounds="True" Background="#0a0a0f">
        <!-- .particles -->
        <Canvas x:Name="Particles" IsHitTestVisible="False" />

        <!-- .game-container -->
        <Grid x:Name="GameView" Visibility="Collapsed" Background="#09080e">
            <ScrollViewer x:Name="MapScroll" Focusable="False"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
                <Grid x:Name="MapHost" />
            </ScrollViewer>
            <!-- Buehne fuer die Levelwechsel-Animation (alte + neue Karte) -->
            <Canvas x:Name="Stage" IsHitTestVisible="False" ClipToBounds="True" Visibility="Collapsed" />
            <!-- HUD oben links -->
            <Border x:Name="Hud" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                    Padding="10,6" CornerRadius="4" Background="#BF09090D" IsHitTestVisible="False">
                <TextBlock x:Name="HudText" FontFamily="Consolas" FontSize="14" LineHeight="19.6" Foreground="#e8dcc0" />
            </Border>
        </Grid>

        <!-- .start-screen -->
        <Grid x:Name="StartScreen">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="StartShift" X="0" />
            </Grid.RenderTransform>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- .title -->
                <Grid HorizontalAlignment="Center" Margin="0,0,0,60">
                    <TextBlock x:Name="TitleText" Text="GET LOST" FontSize="80" FontWeight="Black" HorizontalAlignment="Center">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#f4a637" Offset="0" />
                                <GradientStop Color="#c9843a" Offset="0.4" />
                                <GradientStop Color="#93602f" Offset="1" />
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <!-- .title::after -->
                    <Rectangle Width="120" Height="3" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-15">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00c9843a" Offset="0" />
                                <GradientStop Color="#c9843a" Offset="0.5" />
                                <GradientStop Color="#00c9843a" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>
                <!-- .subtitle -->
                <TextBlock x:Name="SubtitleText" Text="A DUNGEON MAZE GAME" FontSize="14" Foreground="#6b5738"
                           HorizontalAlignment="Center" Margin="0,0,0,60" />
                <!-- .menu -->
                <StackPanel Width="380">
                    <Button x:Name="BtnSingleplayer" Style="{StaticResource MenuButton}">
                        <TextBlock Text="SINGLEPLAYER" />
                    </Button>
                    <Button x:Name="BtnMultiplayer" Style="{StaticResource MenuButton}" IsEnabled="False">
                        <StackPanel>
                            <TextBlock Text="MULTIPLAYER" HorizontalAlignment="Center" />
                            <TextBlock x:Name="ComingSoonText" Text="COMING SOON" FontSize="11" FontWeight="Normal"
                                       Foreground="#6b5738" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- .loading-screen -->
        <Grid x:Name="LoadingScreen" Background="#0a0a0f" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- .spinner-container -->
                <Grid Width="120" Height="120" Margin="0,0,0,40" HorizontalAlignment="Center">
                    <!-- .ring-1: oben + rechts, 1.2s -->
                    <Path x:Name="Ring1" Style="{StaticResource Ring}" Stroke="#c9843a" Width="120" Height="120" Data="M 18.63,18.63 A 58.5,58.5 0 0 1 101.37,101.37">
                        <Path.RenderTransform><RotateTransform /></Path.RenderTransform>
                    </Path>
                    <!-- .ring-2: unten + links, 1.6s rueckwaerts -->
                    <Path x:Name="Ring2" Style="{StaticResource Ring}" Stroke="#f4a637" Width="96" Height="96" Data="M 80.88,80.88 A 46.5,46.5 0 0 1 15.12,15.12">
                        <Path.RenderTransform><RotateTransform /></Path.RenderTransform>
                    </Path>
                    <!-- .ring-3: nur oben, 2s -->
                    <Path x:Name="Ring3" Style="{StaticResource Ring}" Stroke="#93602f" Width="72" Height="72" Data="M 11.60,11.60 A 34.5,34.5 0 0 1 60.40,11.60">
                        <Path.RenderTransform><RotateTransform /></Path.RenderTransform>
                    </Path>
                    <!-- .ring-dot -->
                    <Ellipse x:Name="RingDot" Width="12" Height="12" Fill="#c9843a" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
                <!-- .loading-text / .loading-detail -->
                <TextBlock x:Name="LoadingText" FontSize="16" Foreground="#6b5738" HorizontalAlignment="Center" />
                <TextBlock x:Name="LoadingDetail" FontSize="12" Foreground="#3c2a1c" HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
